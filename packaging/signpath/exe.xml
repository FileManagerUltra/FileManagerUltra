<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "exe": the program, signed before NSIS packaging.
     The GitHub artifact arrives as a ZIP with the exe at its root.
     Paste into SignPath (this app's project > Artifact configurations, slug "exe"). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="filemanagerultra.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
